# Host environment names for the cascade service (M17, ticket 135). NAMES ONLY.
#
# Set each one in the service's Northflank secret group, linked to the
# `voice-pipeline` service, never in git. Setup:
#   deploy/northflank/README.md
#
# Northflank injects them as environment variables at boot. Nothing in this
# repository carries a value: `python deploy/topology.py` fails if any secret
# name here has a value, and ticket 141's repository scan is the second guard.
#
# The Fly.io section below is historical: the host moved to Northflank on
# 2026-10-30 and the Fly app is not deployed.
#
# The non-secret settings are host-supplied too. META_REASONING_EFFORT has no
# committed value: Compose gives `environment` precedence over this file, and a
# blank `[env]` entry on Fly is the blank value the service reads, so neither
# can carry a placeholder. Supply it with `fly secrets set` (or here, in the
# local file). `python deploy/topology.py` fails by name if a required setting
# is set but empty.
#
# The `voni` app has its own secret set on its own app; the two are never
# shared, so a rotated service vendor key cannot silently change the app.

# Meta STT and Chat Completions (meta_stt.API_KEY_ENV, meta_llm).
META_API_KEY=
# Salt for the stable internal identifier sent to Meta (meta_llm IDENTIFIER_SALT_ENV).
META_IDENTIFIER_SALT=
# Cascade synthesis (AssemblyAI TTS) and the managed STT path.
ASSEMBLYAI_API_KEY=
# The managed path's LLM route (AI Gateway URL, never the cascade host).
AI_GATEWAY_API_KEY=
# The app -> service tool route's shared secret (tools.TOOL_SECRET_ENV).
VONI_TOOL_SECRET=
# The signed stored-body envelope (server.py; absent closes the channel).
VOICE_PIPELINE_ENVELOPE_SECRET=
# The shared durable store: Fly Postgres attachment, both machines read it.
DATABASE_URL=

# --- Required non-secret host settings -------------------------------------
# The measured reasoning effort for the default Meta rung (M03). REQUIRED and
# host-supplied: Spark has no default and refuses construction without it, so a
# default-rung call fails setup when this is unset. This file invents no value.
META_REASONING_EFFORT=
# The app's public origin the tool route calls (transport.TOOL_BASE_URL_ENV).
# REQUIRED and host-supplied: when empty, no ToolExecutor is constructed and
# every tool call is dropped.
VOICE_PIPELINE_TOOL_BASE_URL=

# --- Optional non-secret host settings -------------------------------------
# Where each call's operational-event JSONL artifact is written. The image
# creates and owns /var/lib/voni/events; the artifact is best-effort, and a call
# whose write fails still runs (its end message carries eventsError).
VOICE_PIPELINE_EVENTS_DIR=
# The Standard rung's model id; defaults to muse-spark-1.3.
VOICE_PIPELINE_LLM_MODEL=
# The listen port; the image and Fly config set 8766.
VOICE_PIPELINE_PORT=
