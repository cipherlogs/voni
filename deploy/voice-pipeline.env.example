# Host environment names for the cascade service (ticket 19). NAMES ONLY,
# except the two non-secret settings that are deployment facts.
#
# The host is Northflank: set the secrets in the service's secret group, linked
# to the `voice-pipeline` service, never in git. Setup:
#   deploy/northflank/README.md
#
# Northflank injects them as environment variables at boot. Nothing secret in
# this repository carries a value: `python deploy/topology.py` fails if a secret
# name here has a value, and the repository scan is the second guard.
#
# There is exactly ONE envelope secret, VOICE_PIPELINE_ENVELOPE_SECRET: the app
# signs the call body with it and the service verifies with it, one value on
# both sides. A second signing/envelope name is a deploy error.
#
# META_REASONING_EFFORT has no committed value: it is the measured M03 effort
# and the host supplies it. Compose gives `environment` precedence over this
# file, and a blank environment entry is the blank runtime value, so this file
# leaves it empty and the deploy fails by name if a deploy file sets it blank.
#
# The `voni` app has its own secret set on its own deploy; the two are never
# shared, so a rotated service vendor key cannot silently change the app.

# --- Secrets: names only, values from the Northflank secret group -----------
# Meta STT and Chat Completions (meta_stt.API_KEY_ENV, meta_llm).
META_API_KEY=
# Salt for the stable internal identifier sent to Meta (meta_llm IDENTIFIER_SALT_ENV).
META_IDENTIFIER_SALT=
# Cascade synthesis (AssemblyAI TTS) and the managed STT path.
ASSEMBLYAI_API_KEY=
# The managed path's LLM route (AI Gateway URL, never the cascade host).
AI_GATEWAY_API_KEY=
# The app -> service tool route's shared secret (tools.TOOL_SECRET_ENV).
VONI_TOOL_SECRET=
# The one signed stored-body envelope and call-token secret (server.py; absent
# closes the channel). One value on both sides; never committed.
VOICE_PIPELINE_ENVELOPE_SECRET=
# The one Postgres addon's connection string, injected as DATABASE_URL.
DATABASE_URL=

# --- Required non-secret host settings -------------------------------------
# The measured reasoning effort for the default Meta rung (M03). REQUIRED and
# host-supplied: Spark has no default and refuses construction without it, so a
# default-rung call fails setup when this is unset. This file invents no value.
META_REASONING_EFFORT=
# The app's public origin the tool route calls (transport.TOOL_BASE_URL_ENV).
# REQUIRED and a deployment fact, not a secret: when empty, no ToolExecutor is
# constructed and every tool call is dropped.
VOICE_PIPELINE_TOOL_BASE_URL=https://app.voni.cc

# --- Optional non-secret host settings -------------------------------------
# Where each call's operational-event JSONL artifact is written. The image
# creates and owns /var/lib/voni/events on the single-read/write volume; the
# artifact is best-effort, and a call whose write fails still runs (its end
# message carries eventsError).
VOICE_PIPELINE_EVENTS_DIR=
# The Standard rung's model id; defaults to muse-spark-1.3.
VOICE_PIPELINE_LLM_MODEL=
# The listen port; the descriptor and the image set 8766.
VOICE_PIPELINE_PORT=
