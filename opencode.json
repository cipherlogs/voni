{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "next-devtools": {
      "type": "local",
      "command": ["npx", "-y", "next-devtools-mcp@latest"],
      "timeout": 30000
    },
    "claude-flow": {
      "type": "local",
      "command": ["npx", "-y", "ruflo@latest", "mcp", "start"],
      "environment": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "15",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid"
      },
      "timeout": 30000
    },
    "ruv-swarm": {
      "type": "local",
      "command": [
        "node",
        "/home/cipherlogs/mcp-servers/ruv-swarm/node_modules/.bin/ruv-swarm",
        "mcp",
        "start"
      ],
      "environment": {
        "npm_config_update_notifier": "false"
      },
      "timeout": 30000
    },
    "flow-nexus": {
      "type": "local",
      "command": ["npx", "-y", "flow-nexus@latest", "mcp", "start"],
      "environment": {
        "npm_config_update_notifier": "false"
      },
      "timeout": 30000
    },
    "Neon": {
      "type": "remote",
      "url": "https://mcp.neon.tech/mcp?projectId=fragrant-math-52860605",
      "headers": {
        "Authorization": "Bearer {env:NEON_API_KEY}"
      },
      "oauth": false,
      "timeout": 15000
    },
    "Telnyx": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "git+https://github.com/team-telnyx/telnyx-mcp-server.git",
        "telnyx-mcp-server"
      ],
      "environment": {
        "TELNYX_API_KEY": "{env:TELNYX_API_KEY}"
      },
      "timeout": 60000
    },
    "assemblyai-docs": {
      "type": "remote",
      "url": "https://www.assemblyai.com/docs/mcp",
      "timeout": 15000
    }
  }
}
