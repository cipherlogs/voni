{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
    "next-devtools": {
      "type": "local",
      "command": ["npx", "-y", "next-devtools-mcp@latest"],
      "timeout": { "catalog": 30000, "execution": 30000 }
    },
    "Neon": {
      "type": "remote",
      "url": "https://mcp.neon.tech/mcp?projectId=fragrant-math-52860605",
      "headers": {
        "Authorization": "Bearer {file:.secrets/neon_api_key}"
      },
      "oauth": false,
      "timeout": { "catalog": 15000, "execution": 15000 }
    },
    "Telnyx": {
      "type": "local",
      "command": [
        "/usr/bin/uvx",
        "--from",
        "git+https://github.com/team-telnyx/telnyx-mcp-server.git",
        "telnyx-mcp-server"
      ],
      "environment": {
        "TELNYX_API_KEY": "{file:.secrets/telnyx_api_key}"
      },
      "timeout": { "catalog": 120000, "execution": 120000 }
    },
    "assemblyai-docs": {
      "type": "remote",
      "url": "https://www.assemblyai.com/docs/mcp",
      "timeout": { "catalog": 15000, "execution": 15000 }
    }
    }
  }
}
