{
  "name": "voni",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:phone": "next dev --experimental-https",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed-properties.mjs",
    "test": "npm run copilot:manifest:check && node scripts/run-tests.mjs",
    "test:file": "node --import tsx --test",
    "copilot:manifest": "npx tsx scripts/generate-app-manifest.mts",
    "copilot:manifest:check": "node scripts/run-quiet.mjs npx tsx scripts/generate-app-manifest.mts --check",
    "test:jobs:integration": "node --env-file=.env.local --import tsx scripts/verify-jobs.mts",
    "test:delete-race": "node --env-file=.env.local --import tsx scripts/verify-delete-race.mts",
    "test:tools:integration": "node --env-file=.env.local --import tsx scripts/verify-tools.mts",
    "test:dispatch:integration": "node --env-file=.env.local --import tsx scripts/verify-dispatch.mts",
    "test:agent-provisioning": "node --env-file=.env.local --import tsx scripts/verify-agent-provisioning.mts",
    "test:copilot:integration": "node --env-file=.env.local --import tsx scripts/verify-copilot-records.mts",
    "test:mobile:takeover": "node --import tsx scripts/verify-mobile-takeover.mts",
    "call:trace": "node --env-file=.env.local --import tsx scripts/call-trace.mts",
    "eval:demo-agent": "node --env-file=.env.local --import tsx scripts/eval-demo-agent.mts",
    "voice:reference": "node --env-file-if-exists=.env.local --import tsx scripts/render-reference.mts",
    "voice:compare": "node --import tsx scripts/compare-audio.mts",
    "voice:vendor-floor": "node --env-file-if-exists=.env.local --import tsx scripts/capture-vendor-floor.mts",
    "voice:levels": "node --env-file-if-exists=.env.local --import tsx scripts/measure-voice-levels.mts",
    "voice:clips": "node --env-file-if-exists=.env.local --import tsx scripts/render-audition-clips.mts",
    "voice:packs": "node --import tsx scripts/reviewer-pack.mts",
    "qa:voice-session": "node --env-file-if-exists=.env.local --import tsx scripts/qa-voice-session.mts",
    "voice:reaudition": "node --env-file-if-exists=.env.local --import tsx scripts/reaudition.mts",
    "operator:credential": "node --env-file-if-exists=.env.local --import tsx scripts/rotate-platform-credential.mts",
    "test:e2e:instant": "node scripts/e2e-run.mjs instant",
    "test:e2e:behavior": "node scripts/e2e-run.mjs behavior",
    "test:e2e:cloudflare": "node scripts/e2e-run.mjs cloudflare",
    "test:e2e:cascade": "node scripts/e2e-run.mjs cascade",
    "test:e2e": "node scripts/e2e-run.mjs all",
    "postinstall": "patch-package",
    "scoreboard:demo": "node --env-file-if-exists=.env.local --import tsx scripts/score-demo.mts",
    "scoreboard:matrix": "node --env-file-if-exists=.env.local --import tsx scripts/score-matrix.mts",
    "scoreboard:kill": "node --env-file-if-exists=.env.local --import tsx scripts/score-kill.mts",
    "scoreboard:streak": "node --env-file-if-exists=.env.local --import tsx scripts/score-streak.mts",
    "typecheck": "next typegen && tsc --noEmit",
    "scoreboard:inspect": "node --import tsx scripts/scoreboard-inspect.mts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.60",
    "@base-ui/react": "^1.7.0",
    "@neon/config": "^1.2.0",
    "@neon/env": "^1.2.0",
    "@neondatabase/serverless": "^1.1.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "@shadcn/react": "^0.3.1",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^7.0.93",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "shadcn": "^4.20.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@next/playwright": "16.3.4",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "patch-package": "^8.0.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.128.0"
  }
}
