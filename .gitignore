.claude/settings.local.json

# Impeccable design-review artifacts (local critiques/screenshots)
.impeccable/

# Unlazy gate-runner state (locks + local ledgers)
.unlazy/

# Local indexes & scratch
ruvector.db
.superpowers/
# Agent working notes (tickets, specs, research). Intentionally untracked; ignored
# so a note written during a certification run cannot move the code fingerprint.
.scratch/

# Voni gate ledger (unlazy runner output, regenerated per run)
voni/GATES.md

# Local video-making workspace
/demo/

# Local cascade runtime (ticket 21): a generated dev TLS cert (never a private
# key in git) and the dedicated pipeline Postgres data dir.
voni/.dev-certs/
.dev-postgres/

# Dev delivered capture (WAV of what the playout worklet emitted; working file)
voni/.captures/

# Local Studio takes (ticket 23): hashed working audio + take records. A take
# joins a committed corpus only when a human promotes it deliberately.
voni/.studio/

# Demo scoreboard run artifacts (regenerated per run, never committed)
voni/scoreboard-runs/

# Demo verification run directories (per-run trace, end doc, PCM; never committed)
voni/.demo-runs/

# Kept platform channel captures from session QA (audio evidence, never committed)
voice-captures/

# Fixed caller clips for the demo scoreboard (PCM cache, regenerated on miss)
voni/.eval-clips/

# W0 reference captures: one WAV per voice + line (regenerated, never committed)
voni/.voice-references/

# M00 latency-spike working audio (regenerated; only the sidecar is committed)
voice-pipeline/.spike/
# Per-call operational-event artifacts (ticket 110): generated working files.
voice-pipeline/.events/
